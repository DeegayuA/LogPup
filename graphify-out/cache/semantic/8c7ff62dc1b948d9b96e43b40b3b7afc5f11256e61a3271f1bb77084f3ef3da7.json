{"nodes": [{"id": "docs_superpowers_specs_2026_08_10_logpup_design_design_spec", "label": "LogPup Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_10_logpup_design_logpup", "label": "LogPup", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Purpose", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal project-management webapp for a tech lead managing 30+ people across many internal apps; answers three daily questions: who works on what (and how loaded), what is each team shipping this sprint, and how to get the right people into a meeting fast."}, {"id": "docs_superpowers_specs_2026_08_10_logpup_design_roles_model", "label": "Admin/Member Role Model", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Users & roles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only two auth roles: admin (the tech lead, full access) and member (reads all, updates own task status); app-level 'lead' is deliberately a designation on the app record, not a separate auth role. Enforced in every action, not just UI."}, {"id": "docs_superpowers_specs_2026_08_10_logpup_design_capacity_allocation", "label": "Capacity & Allocation Model", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Data model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "assignments join users to apps with a role and allocation %, unique per (user, app); per-user allocation sum drives the capacity view and over 100% sets an overallocated flag that warns but never blocks."}, {"id": "docs_superpowers_specs_2026_08_10_logpup_design_non_blocking_integrations", "label": "Non-Blocking Integration Failures", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External APIs (Notion, Google Calendar) must never block the core DB save: save first, then call the API; the record persists and the integration error surfaces separately as a toast with a retry affordance."}, {"id": "docs_superpowers_specs_2026_08_10_logpup_design_yagni_scope", "label": "YAGNI Out-of-Scope Boundary", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Out of scope (YAGNI)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-way Notion sync, epics/story points/velocity/burndown, time tracking, timeboxed allocation history, Slack/Teams notifications, and mobile app are excluded \u2014 all can be added later without schema upheaval."}], "edges": [{"source": "docs_superpowers_specs_2026_08_10_logpup_design_design_spec", "target": "docs_superpowers_specs_2026_08_10_logpup_design_logpup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Purpose", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_10_logpup_design_roles_model", "target": "docs_superpowers_specs_2026_08_10_logpup_design_logpup", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Users & roles", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_10_logpup_design_non_blocking_integrations", "target": "docs_superpowers_plans_2026_08_10_logpup_google_calendar_integration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Architecture (integration failures never block core saves)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_10_logpup_design_non_blocking_integrations", "target": "docs_superpowers_plans_2026_08_10_logpup_notion_export", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Architecture (integration failures never block core saves)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_10_logpup_design_yagni_scope", "target": "docs_superpowers_specs_2026_08_10_logpup_design_design_spec", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Out of scope (YAGNI)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_10_logpup_design_roles_model", "target": "docs_superpowers_plans_2026_08_10_logpup_task_move_permissions", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md", "source_location": "## Users & roles (member updates own task status)", "weight": 1.0}], "hyperedges": [{"id": "external_integration_resilience", "label": "External Integration Resilience (save first, warn on API failure)", "nodes": ["docs_superpowers_specs_2026_08_10_logpup_design_non_blocking_integrations", "docs_superpowers_plans_2026_08_10_logpup_google_calendar_integration", "docs_superpowers_plans_2026_08_10_logpup_notion_export"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-10-logpup-design.md"}]}