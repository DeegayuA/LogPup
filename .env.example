DATABASE_URL=
AUTH_SECRET=
# Dedicated secret for encrypting stored Gemini API keys (per-user keys in
# the geminiKeys table). Kept separate from AUTH_SECRET so rotating the
# session secret doesn't also invalidate every stored Gemini key. Optional —
# falls back to deriving from AUTH_SECRET when unset. Generate with:
# openssl rand -base64 32
GEMINI_KEY_ENCRYPTION_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated allowed sign-in domains. Google sign-in is now open self-signup
# (any verified Google account may sign in and lands pending admin approval — see
# src/lib/auth.ts), so this no longer gates Google. It still gates the password and
# Notion providers, which have no self-signup flow and require an admin-created row.
ALLOWED_EMAIL_DOMAINS=altavision.lk,syntaxgenie.com,pearlcluster.lk,altavision.co.uk
# Base URL for OAuth redirect URIs. In prod set to your deployed origin.
AUTH_URL=http://localhost:3000
# Notion public OAuth integration (enables "Continue with Notion")
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Testing: set to 1 to show the admin "Clear database" button. Remove when done.
ENABLE_DB_CLEAR=
# Daily backup cron (Vercel). CRON_SECRET authorizes the endpoint; BACKUP_ENCRYPTION_KEY
# encrypts each dump. BLOB_READ_WRITE_TOKEN is set for you when you create a Blob store.
CRON_SECRET=
BACKUP_ENCRYPTION_KEY=
BLOB_READ_WRITE_TOKEN=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Local dev only — one-click passwordless login. Leave BOTH unset in every
# deployed/preview/CI environment; production crashes at boot if E2E_TEST_MODE=1.
# DEV_LOGIN_EMAIL=dev@altavision.lk
# E2E_TEST_MODE=1

# Gemini Live streaming transcription (Sinhala + English, realtime).
# ON by default; set to exactly "0" to force the Web-Speech-only fallback.
# When the live path can't start (key without Live access, quota, outage) it
# degrades to Web Speech automatically and the recording continues either way.
# Streaming bills a user's own Gemini key continuously for the whole recording
# (~90,000 audio input tokens per hour), so free-tier quota is shared with
# every other AI feature in LogPup — the "0" kill switch exists for that.
# NEXT_PUBLIC_GEMINI_LIVE_TRANSCRIPTION=0
# Optional override — Live models are all Preview and get renamed/retired often,
# so this exists to avoid needing a code change when that happens. When minting
# fails for this model the server also tries the older 2.5 native-audio preview.
# NEXT_PUBLIC_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Optional. Lets "Generate" on the app form read PRIVATE GitHub repos when
# writing a description from the README (src/features/apps/repo-metadata.ts).
# Public repos work without it, at GitHub's 60 req/hour unauthenticated limit.
# Fine-grained PAT, Contents: read-only, scoped to the repos you track.
# Without it a private repo reports "not found" — GitHub answers 404 rather
# than 403 for private repos, so the feature cannot tell that apart from a typo.
GITHUB_TOKEN=
