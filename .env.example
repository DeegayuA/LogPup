DATABASE_URL=
AUTH_SECRET=
# Dedicated secret for encrypting stored Gemini API keys (per-user keys in
# the geminiKeys table). Kept separate from AUTH_SECRET so rotating the
# session secret doesn't also invalidate every stored Gemini key. Optional —
# falls back to deriving from AUTH_SECRET when unset. Generate with:
# openssl rand -base64 32
GEMINI_KEY_ENCRYPTION_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated allowed sign-in domains. Google sign-in is now open self-signup
# (any verified Google account may sign in and lands pending admin approval — see
# src/lib/auth.ts), so this no longer gates Google. It still gates the password and
# Notion providers, which have no self-signup flow and require an admin-created row.
ALLOWED_EMAIL_DOMAINS=altavision.lk,syntaxgenie.com,pearlcluster.lk,altavision.co.uk
# Base URL for OAuth redirect URIs. In prod set to your deployed origin.
AUTH_URL=http://localhost:3000
# Notion public OAuth integration (enables "Continue with Notion")
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# GitHub OAuth app (enables "Continue with GitHub"). Callback URL to register
# with GitHub: {AUTH_URL}/api/auth/callback/github
#
# Sign-in only, and only for somebody who ALREADY has an account here — unlike
# Google, GitHub does not auto-provision, because a GitHub email is often
# personal and may be unverified or hidden entirely. Leaving these blank simply
# omits the button.
#
# NOT the same credential as reading commit history: that wants a GitHub App
# installed on the org, so the data keeps working for people who never signed
# in with GitHub and after somebody leaves.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App for reading org commit history (worklog "Fill from my day"
# evidence). All three or nothing — the integration is inert until every one
# is set. Full walkthrough: docs/github-setup.md. The private key is the PEM
# downloaded when generating a key on the App; paste with literal \n for the
# newlines, the reader undoes that.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Testing: set to 1 to show the admin "Clear database" button. Remove when done.
ENABLE_DB_CLEAR=
# Daily backup cron (Vercel). CRON_SECRET authorizes the endpoint; BACKUP_ENCRYPTION_KEY
# encrypts each dump. BLOB_READ_WRITE_TOKEN is set for you when you create a Blob store.
CRON_SECRET=
BACKUP_ENCRYPTION_KEY=
BLOB_READ_WRITE_TOKEN=

# ── Attendance Web App bridge (see docs/attendance-task-bridge.md) ──
# Three DISTINCT secrets, one per job. Sharing one would mean a single compromised integration
# hands over the task API, the sign-in handoff and the notification channel at once.
#
# 1. The task API (/api/external/*). Sent by Attendance as x-api-key. Unset = every request is
#    refused, because an unauthenticated task API is a public read of everyone's work.
LOGPUP_EXTERNAL_API_KEY=
# 2. Email domains the bridge will resolve. NOT the same list as ALLOWED_EMAIL_DOMAINS above:
#    that decides who may SIGN IN and carries four domains, and widening sign-in must never
#    silently widen what a shared API key can read. Defaults to altavision.lk when unset.
LOGPUP_BRIDGE_DOMAINS=altavision.lk
# 3. Where task events are posted so an assignment reaches somebody's phone. Unset disables the
#    fan-out only — the in-app notification is unaffected.
ATTENDANCE_WEBHOOK_URL=
# 4. HMAC-SHA256 signing secret for that POST. Not the API key, not the SSO secret.
LOGPUP_WEBHOOK_SECRET=
# 5. The sign-in handoff, both directions. Must be byte-identical to the value set on the
#    Attendance deployment — it signs there and verifies here (and the reverse). Not the API key
#    above, and emphatically not Attendance's ATTENDANCE_JWT_SECRET, which belongs to Solar.
#    Unset means the 'attendance-sso' provider is not registered at all: arriving handoffs are
#    refused rather than half-working. Any long random string; generate with
#    `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
LOGPUP_SSO_SECRET=
# 6. Where the Attendance app lives, for the outbound handoff and the sidebar button. Mirrors
#    how that repo names this one (LOGPUP_APP_URL). Optional — defaults to production, so set it
#    only to point a preview deployment at a preview.
ATTENDANCE_APP_URL=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Local dev only — one-click passwordless login. Leave BOTH unset in every
# deployed/preview/CI environment; production crashes at boot if E2E_TEST_MODE=1.
# DEV_LOGIN_EMAIL=dev@altavision.lk
# E2E_TEST_MODE=1

# Gemini Live streaming transcription (Sinhala + English, realtime).
# ON by default; set to exactly "0" to force the Web-Speech-only fallback.
# When the live path can't start (key without Live access, quota, outage) it
# degrades to Web Speech automatically and the recording continues either way.
# Streaming bills a user's own Gemini key continuously for the whole recording
# (~90,000 audio input tokens per hour), so free-tier quota is shared with
# every other AI feature in LogPup — the "0" kill switch exists for that.
# NEXT_PUBLIC_GEMINI_LIVE_TRANSCRIPTION=0
# Optional override — Live models are all Preview and get renamed/retired often,
# so this exists to avoid needing a code change when that happens. When minting
# fails for this model the server also tries the older 2.5 native-audio preview.
# NEXT_PUBLIC_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# API version for the Live WebSocket. Default v1beta (what Google's
# ephemeral-token guide documents). Set to v1alpha if the token mint succeeds
# but the socket closes immediately — Google's own browser sample still uses
# v1alpha and both routes currently resolve.
# NEXT_PUBLIC_GEMINI_LIVE_WS_VERSION=v1alpha

# Optional. Lets "Generate" on the app form read PRIVATE GitHub repos when
# writing a description from the README (src/features/apps/repo-metadata.ts).
# Public repos work without it, at GitHub's 60 req/hour unauthenticated limit.
# Fine-grained PAT, Contents: read-only, scoped to the repos you track.
# Without it a private repo reports "not found" — GitHub answers 404 rather
# than 403 for private repos, so the feature cannot tell that apart from a typo.
GITHUB_TOKEN=

# Browser console command for planned maintenance: window.maintenance('<password>').
# Set this to the SHA-256 HEX of the password — the plaintext must never be
# committed, and only the hash is ever shipped to the browser. Generate with:
# printf '%s' 'your-password' | shasum -a 256
# Optional: falls back to a documented default hash in
# src/features/maintenance/components/maintenance-gate.tsx when unset.
#
# THE PASSWORD IS NOT THE SECURITY. It keeps the command out of the way of
# somebody idly typing into a console. What actually gates maintenance is the
# 'maintenance.manage' capability, checked in the server action, and the
# database write gate in src/db/write-gate.ts.
NEXT_PUBLIC_MAINTENANCE_HASH=
